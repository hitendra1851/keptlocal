---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PrivacyBadge from "../components/PrivacyBadge.astro";
import FAQ from "../components/FAQ.astro";
import { tools } from "../data/tools";
import type { Tool } from "../data/tools";
import { posts } from "../data/posts";
import type { Post } from "../data/posts";

export interface Props {
  tool: Tool;
}

const { tool } = Astro.props;

// Related tools: the next 5 live tools in the same category, wrapping around the
// registry. Rotating (instead of always the first few) gives every tool inbound links.
const sameCategory = tools.filter((t) => t.category === tool.category && t.status === "live");
const ownIndex = sameCategory.findIndex((t) => t.slug === tool.slug);
const relatedTools = [...sameCategory.slice(ownIndex + 1), ...sameCategory.slice(0, Math.max(ownIndex, 0))]
  .slice(0, 5);

// Blog posts to feature on each tool page (slugs; titles come from the post registry).
const blogMap: Record<string, string[]> = {
  "merge-pdf": ["merge-pdf-without-uploading", "why-pdf-tools-should-not-upload-your-files", "keptlocal-vs-ilovepdf-vs-smallpdf"],
  "split-pdf": ["how-to-split-a-pdf-without-uploading", "smallpdf-alternatives-no-signup"],
  "pdf-to-jpg": ["pdf-to-jpg-when-and-when-not-to-convert"],
  "pdf-to-png": ["pdf-to-jpg-when-and-when-not-to-convert", "how-to-extract-text-from-pdf"],
  "jpg-to-pdf": ["how-to-convert-jpg-to-pdf"],
  "compress-pdf": ["compress-pdf-file-size-vs-quality", "how-to-compress-pdf-for-email", "smallpdf-alternatives-no-signup"],
  "delete-pages-pdf": ["how-to-remove-pages-from-pdf"],
  "add-page-numbers-pdf": ["how-to-add-page-numbers-to-pdf"],
  "pdf-to-text": ["how-to-extract-text-from-pdf"],
  "unlock-pdf": ["how-to-remove-pdf-password"],
  "compress-image": ["how-to-compress-image-to-specific-file-size", "image-compression-formats-jpg-webp-avif-2026"],
  "convert-image": ["heic-to-jpg-iphone-photo-problem", "image-compression-formats-jpg-webp-avif-2026", "heic-jpg-png-webp-avif-which-format-to-use"],
  "qr-code-generator": ["qr-code-guide-free-no-signup"],
  "rotate-pdf": ["how-to-rotate-pdf-pages"],
  "sign-pdf": ["how-to-sign-a-pdf-online"],
  "protect-pdf": ["how-to-password-protect-a-pdf"],
  "uuid-generator": ["what-is-a-uuid"],
  "json-formatter": ["how-to-validate-json-online"],
  "watermark-pdf": ["how-to-watermark-a-pdf"],
  "fill-pdf-form": ["how-to-fill-out-a-pdf-form"],
  "word-counter": ["how-word-count-actually-works"],
  "hash-generator": ["md5-vs-sha256-which-hash-to-use"],
  "favicon-generator": ["how-to-make-a-favicon"],
  "reorder-pdf": ["how-to-reorder-pdf-pages"],
  "password-generator": ["how-to-generate-a-strong-password"],
  "resize-image": ["how-to-resize-an-image-without-losing-quality"],
  "unit-converter": ["why-temperature-conversion-is-different"],
  "case-converter": ["camelcase-vs-snake-case-vs-kebab-case"],
  "rotate-image": ["how-to-rotate-a-photo-without-losing-quality"],
  "flip-image": ["when-to-flip-vs-rotate-an-image"],
  "remove-image-exif": ["what-is-exif-data-and-why-strip-it"],
  "image-watermark": ["how-to-watermark-a-photo"],
  "social-image-resizer": ["correct-image-sizes-for-social-media-2026"],
  "image-to-base64": ["what-is-base64-encoding"],
  "flatten-pdf": ["what-does-flattening-a-pdf-actually-do"],
  "crop-pdf": ["how-to-remove-margins-from-a-pdf"],
  "pdf-page-count": ["how-to-check-a-pdfs-page-count-and-metadata"],
  "passport-photo-maker": ["passport-photo-size-requirements-by-country"],
  "add-image-to-pdf": ["how-to-convert-jpg-to-pdf"],
  "crop-image": ["how-to-crop-an-image-online-free"],
  "grayscale-image": ["heic-jpg-png-webp-avif-which-format-to-use"],
  "heic-to-jpg": ["heic-to-jpg-iphone-photo-problem", "heic-jpg-png-webp-avif-which-format-to-use"],
  "jpg-to-png": ["heic-jpg-png-webp-avif-which-format-to-use"],
  "png-to-jpg": ["heic-jpg-png-webp-avif-which-format-to-use", "image-compression-formats-jpg-webp-avif-2026"],
  "svg-to-png": ["how-to-make-a-favicon", "heic-jpg-png-webp-avif-which-format-to-use"],
  "webp-to-jpg": ["image-compression-formats-jpg-webp-avif-2026"],
};
const relatedPosts = (blogMap[tool.slug] ?? [])
  .map((slug) => posts.find((p) => p.slug === slug))
  .filter((p): p is Post => p !== undefined);

const baseTitle = tool.pageTitle || tool.name;
// Skip the "Free & Private" suffix when the title already says "Free" or would pass ~60 chars.
const fullTitle = `${baseTitle} — Free & Private | keptlocal`;
const alreadyFree = baseTitle.toLowerCase().includes("free");
const shortTitle = `${baseTitle} | keptlocal`.length > 60 ? baseTitle : `${baseTitle} | keptlocal`;
const title = alreadyFree || fullTitle.length > 60 ? shortTitle : fullTitle;
const description = tool.longDescription || tool.description;
// Per-tool social image, generated at build by src/pages/og/[...slug].png.ts
const ogImage = `/og/tools/${tool.slug}.png`;

// Schema: WebApplication + FAQPage + BreadcrumbList
const schema: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: tool.name,
    description,
    url: `https://keptlocal.com/tools/${tool.slug}/`,
    image: `https://keptlocal.com${ogImage}`,
    applicationCategory: tool.category === "PDF" || tool.category === "Utility" ? "UtilitiesApplication" : "MultimediaApplication",
    operatingSystem: "Any (Web Browser)",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    browserRequirements: "Requires a modern browser with JavaScript enabled.",
    permissions: "No permissions required. Runs entirely in the browser.",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://keptlocal.com/" },
      { "@type": "ListItem", position: 2, name: `${tool.category} Tools`, item: "https://keptlocal.com/tools/" },
      { "@type": "ListItem", position: 3, name: tool.name, item: `https://keptlocal.com/tools/${tool.slug}/` },
    ],
  },
];

if (tool.faq.length > 0) {
  schema.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: tool.faq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  });
}
---

<BaseLayout title={title} description={description} schema={schema} ogImage={ogImage}>
  <Header />

  <main class="max-w-5xl mx-auto px-6 pt-10 pb-16">
    <!-- Breadcrumb -->
    <nav class="text-xs text-[var(--color-ink-muted)] mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[var(--color-ink)]">Home</a>
      <span class="mx-2">/</span>
      <span>{tool.category} Tools</span>
      <span class="mx-2">/</span>
      <span class="text-[var(--color-ink-soft)]">{tool.name}</span>
    </nav>

    <!-- Tool header -->
    <div class="mb-8 reveal">
      <PrivacyBadge variant="block" />
      <h1 class="font-display text-4xl md:text-5xl text-[var(--color-ink)] mt-4 mb-3 tracking-tighter">
        {tool.pageTitle || tool.name}
      </h1>
      <p class="text-lg text-[var(--color-ink-soft)] max-w-2xl leading-relaxed">
        {tool.longDescription || tool.description}
      </p>
    </div>

    <!-- The tool itself -->
    <div class="reveal" style="animation-delay: 0.1s">
      <slot name="tool" />
    </div>

    <!-- Ad slot: below tool output is the highest-RPM slot -->
    <div class="ad-slot" data-ad-position="below-tool"></div>

    <!-- SEO content body -->
    <div class="grid md:grid-cols-3 gap-12 mt-12">
      <article class="md:col-span-2 prose-doc">
        <slot name="content" />

        {tool.faq.length > 0 && (
          <>
            <h2>Frequently asked questions</h2>
            <FAQ items={tool.faq} />
          </>
        )}
      </article>

      <aside class="md:col-span-1">
        <div class="sticky top-24 space-y-6">
          <div class="ad-slot" data-ad-position="sidebar" style="min-height: 250px;"></div>
          {relatedTools.length > 0 && (
            <div class="p-5 rounded-lg border border-[var(--color-rule)] bg-[var(--color-paper-dark)]">
              <h3 class="font-medium text-sm text-[var(--color-ink)] mb-3">
                More {tool.category} tools
              </h3>
              <ul class="space-y-2">
                {relatedTools.map((t) => (
                  <li>
                    <a
                      href={`/tools/${t.slug}/`}
                      class="text-sm text-[var(--color-accent)] hover:underline underline-offset-4"
                    >
                      {t.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {relatedPosts.length > 0 && (
            <div class="p-5 rounded-lg border border-[var(--color-rule)] bg-[var(--color-paper-dark)]">
              <h3 class="font-medium text-sm text-[var(--color-ink)] mb-3">From the blog</h3>
              <ul class="space-y-2">
                {relatedPosts.map((p) => (
                  <li>
                    <a
                      href={`/blog/${p.slug}/`}
                      class="text-sm text-[var(--color-accent)] hover:underline underline-offset-4 leading-snug block"
                    >
                      {p.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <div class="p-5 rounded-lg border border-[var(--color-rule)] bg-[var(--color-paper-dark)]">
            <h3 class="font-medium text-sm text-[var(--color-ink)] mb-3">Verify it's local</h3>
            <ol class="text-sm text-[var(--color-ink-soft)] space-y-2 list-decimal pl-4">
              <li>Open browser DevTools (F12)</li>
              <li>Switch to the Network tab</li>
              <li>Run the tool above</li>
              <li>No POST or upload requests appear</li>
            </ol>
          </div>
        </div>
      </aside>
    </div>
  </main>

  <Footer />
</BaseLayout>
