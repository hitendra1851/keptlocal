---
import "../styles/global.css";
import "@fontsource-variable/fraunces/opsz.css";
import "@fontsource-variable/dm-sans/index.css";
import frauncesLatin from "@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url";

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = "/og-default.png",
  schema,
  noindex = false,
} = Astro.props;

const siteUrl = "https://keptlocal.com";
const canonicalUrl = canonical ?? `${siteUrl}${Astro.url.pathname}`;
const fullOgImage = ogImage.startsWith("http") ? ogImage : `${siteUrl}${ogImage}`;

// Site-wide Organization schema (every page)
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "keptlocal",
  url: `${siteUrl}/`,
  "@id": `${siteUrl}/#org`,
  sameAs: [
    "https://www.linkedin.com/in/hitendrapatel2",
    "https://medium.com/@hitendra.patel2986",
  ],
  founder: {
    "@type": "Person",
    "@id": `${siteUrl}/about/#person`,
    name: "Hitendra Patel",
    url: `${siteUrl}/about/`,
  },
  logo: {
    "@type": "ImageObject",
    url: `${siteUrl}/logo.png`,
    width: 512,
    height: 512,
  },
  description:
    "Private, browser-only PDF and image tools. Your files never leave your device.",
};

const schemaArray = Array.isArray(schema)
  ? [orgSchema, ...schema]
  : schema
    ? [orgSchema, schema]
    : [orgSchema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Google Search Console verification: go to search.google.com/search-console,
         add https://keptlocal.com as a URL-prefix property, choose the "HTML tag"
         verification method, and paste the content value below. -->
    <!-- <meta name="google-site-verification" content="PASTE_YOUR_CODE_HERE" /> -->

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:site_name" content="keptlocal" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- PWA: lets keptlocal be installed and keeps already-opened tools working offline -->
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Fonts are self-hosted via @fontsource-variable (no third-party render-blocking CSS) -->
    <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />

    <!-- Theme color matches paper -->
    <meta name="theme-color" content="#faf8f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16140f" media="(prefers-color-scheme: dark)" />

    <!-- Set theme before paint to prevent FOUC -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem("theme");
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          if (stored === "dark" || (!stored && prefersDark)) {
            document.documentElement.classList.add("dark");
          }
        } catch (_) {}
      })();
    </script>

    <!-- Schema.org -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schemaArray)}
    />

    <!-- Google Analytics 4 -->
    <!-- The 179 KB gtag.js is loaded ~2.5s after the load event, in idle time. Loading it
         right at load (~0.5s) still landed before LCP: Lighthouse mobile measured homepage
         LCP 4.3s with gtag vs 2.0s with it blocked. Events queued in dataLayer are still
         sent once it loads; visits that leave within ~3s are not counted. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-YGS0FP9RG4', { anonymize_ip: true });
      window.addEventListener('load', function () {
        setTimeout(function () {
          var inject = function () {
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=G-YGS0FP9RG4';
            document.head.appendChild(s);
          };
          if ('requestIdleCallback' in window) requestIdleCallback(inject, { timeout: 2000 });
          else inject();
        }, 2500);
      });
    </script>

    {/* AdSense: add the adsbygoogle.js script here once approved, with the real
        ca-pub client ID. Do not leave a placeholder-ID script in this file: Astro
        emits <script> tags even when they are wrapped in an HTML comment. */}

    <!-- Service worker: registered after load so it never delays first paint.
         Lets a tool page keep working if the visitor loses their connection or
         reopens the tab later, once they've opened it at least once online. -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </head>
  <body class="paper-grain">
    <slot />
  </body>
</html>
