---
---

<div id="uuid-app" class="border border-[var(--color-rule)] rounded-xl overflow-hidden bg-[var(--color-paper)]">
  <div class="p-5 space-y-5">

    <!-- Output -->
    <div class="relative">
      <textarea
        id="uuid-output"
        readonly
        rows="8"
        class="w-full font-mono text-sm text-[var(--color-ink)] bg-[var(--color-paper-dark)] border border-[var(--color-rule)] rounded-lg px-4 py-3 pr-4 leading-relaxed resize-y select-all focus:outline-none focus:border-[var(--color-accent)]"
        placeholder="Click Generate to create UUIDs"
      ></textarea>
    </div>

    <!-- Count -->
    <div>
      <div class="flex items-center justify-between mb-2">
        <label for="uuid-count" class="text-sm font-medium text-[var(--color-ink)]">How many</label>
        <span id="count-display" class="text-sm font-mono font-semibold text-[var(--color-accent)]">1</span>
      </div>
      <input type="range" id="uuid-count" min="1" max="1000" value="1" step="1"
        class="w-full accent-[var(--color-accent)] cursor-pointer" />
      <div class="flex justify-between text-xs text-[var(--color-ink-muted)] mt-1">
        <span>1</span><span>1,000</span>
      </div>
    </div>

    <!-- Format -->
    <div>
      <label class="block text-sm font-medium text-[var(--color-ink)] mb-2">Format</label>
      <div class="grid grid-cols-3 gap-2">
        {[
          { id: "fmt-plain", label: "One per line", value: "plain", defaultChecked: true },
          { id: "fmt-csv", label: "Comma-separated", value: "csv", defaultChecked: false },
          { id: "fmt-json", label: "JSON array", value: "json", defaultChecked: false },
        ].map(({ id, label, value, defaultChecked }) => (
          <label class="flex items-center gap-2 cursor-pointer text-xs text-[var(--color-ink-soft)] border border-[var(--color-rule)] rounded-md px-2 py-2">
            <input type="radio" name="uuid-format" id={id} value={value} checked={defaultChecked}
              class="accent-[var(--color-accent)] w-3.5 h-3.5 cursor-pointer" />
            {label}
          </label>
        ))}
      </div>
    </div>

    <label class="flex items-center gap-2 cursor-pointer text-sm text-[var(--color-ink-soft)]">
      <input type="checkbox" id="opt-uppercase" class="accent-[var(--color-accent)] w-3.5 h-3.5 cursor-pointer" />
      Uppercase
    </label>
  </div>

  <div class="border-t border-[var(--color-rule)] px-4 py-3 bg-[var(--color-paper-dark)] flex flex-col sm:flex-row gap-3 sm:items-center sm:justify-between">
    <div id="status-msg" class="text-sm text-[var(--color-ink-muted)]">Set a count and click Generate.</div>
    <div class="flex gap-2">
      <button type="button" id="copy-btn" class="px-3 py-2 rounded-md text-xs font-medium border border-[var(--color-rule)] bg-[var(--color-paper)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] transition-colors text-[var(--color-ink-muted)]">
        <span id="copy-label">Copy all</span>
      </button>
      <button type="button" id="gen-btn" class="btn-primary">Generate</button>
    </div>
  </div>
</div>

<script>
  const $ = (id: string) => document.getElementById(id) as HTMLElement;

  const genOne = (uppercase: boolean) => {
    const id = crypto.randomUUID();
    return uppercase ? id.toUpperCase() : id;
  };

  const generate = () => {
    const count = parseInt(($("uuid-count") as HTMLInputElement).value);
    const uppercase = ($("opt-uppercase") as HTMLInputElement).checked;
    const format = (document.querySelector('input[name="uuid-format"]:checked') as HTMLInputElement)?.value || "plain";

    const ids = Array.from({ length: count }, () => genOne(uppercase));

    let out = "";
    if (format === "csv") out = ids.join(", ");
    else if (format === "json") out = JSON.stringify(ids, null, 2);
    else out = ids.join("\n");

    ($("uuid-output") as HTMLTextAreaElement).value = out;
    $("status-msg").textContent = `${count.toLocaleString()} UUID${count === 1 ? "" : "s"} generated · v4 (random), RFC 4122`;
    $("status-msg").style.color = "";
  };

  $("uuid-count").addEventListener("input", () => {
    $("count-display").textContent = parseInt(($("uuid-count") as HTMLInputElement).value).toLocaleString();
  });

  $("gen-btn").addEventListener("click", generate);

  $("copy-btn").addEventListener("click", () => {
    const text = ($("uuid-output") as HTMLTextAreaElement).value;
    if (!text) return;
    navigator.clipboard.writeText(text).then(() => {
      $("copy-label").textContent = "Copied!";
      setTimeout(() => { $("copy-label").textContent = "Copy all"; }, 1800);
    });
  });

  // Generate on load
  generate();
</script>
